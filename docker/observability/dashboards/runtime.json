    {"id": 11, "title": "CPU · занято", "type": "stat", "gridPos": {"x": 0, "y": 3, "w": 6, "h": 5}, "description": "Среднее по всем vCPU. Включает I/O wait; ниже он показан отдельно.", "fieldConfig": {"defaults": {"unit": "percent", "noValue": "Нет данных", "decimals": 1, "min": 0, "mappings": [{"type": "special", "options": {"match": "null", "result": {"text": "Нет данных", "color": "gray"}}}], "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "red", "value": 90}]}, "max": 100}, "overrides": []}, "datasource": {"type": "prometheus", "uid": "prometheus_main"}, "targets": [{"refId": "A", "expr": "(100 * (1 - avg by(instance) (rate(node_cpu_seconds_total{instance=\"176.108.242.211:9100\",job=\"BOOHTA_cloud\",mode=\"idle\"}[$__rate_interval])))) and on(instance) (up{instance=\"176.108.242.211:9100\",job=\"BOOHTA_cloud\"} == 1)", "legendFormat": "", "instant": true, "range": false}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "textMode": "auto", "wideLayout": true}},
