{
  "uid": "boohtacord-runtime",
  "title": "BOOHTACORD | Runtime",
  "tags": ["boohtacord", "sre", "opentelemetry"],
  "schemaVersion": 40,
  "version": 0,
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"id": 1, "title": "Цели телеметрии доступны (из 3)", "type": "stat", "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "boohtacord_metrics"}, "targets": [{"refId": "A", "expr": "sum(up{job=~\"boohtacord-(otel-metrics|tempo|prometheus)\"})", "instant": true}], "fieldConfig": {"defaults": {}, "overrides": []}, "description": "Коллектор метрик, Tempo и Prometheus должны давать 3 из 3."},
    {"id": 2, "title": "HTTP запросов с запуска API", "type": "stat", "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0}, "datasource": {"type": "prometheus", "uid": "boohtacord_metrics"}, "targets": [{"refId": "A", "expr": "sum(boohtacord_http_server_requests_total) or vector(0)", "instant": true}], "fieldConfig": {"defaults": {}, "overrides": []}},
    {"id": 3, "title": "Доля HTTP 5xx с запуска API", "type": "stat", "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0}, "datasource": {"type": "prometheus", "uid": "boohtacord_metrics"}, "targets": [{"refId": "A", "expr": "100 * (sum(boohtacord_http_server_requests_total{http_response_status_code=~\"5..\"}) or vector(0)) / clamp_min(sum(boohtacord_http_server_requests_total), 1)", "instant": true}], "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []}},
    {"id": 4, "title": "Принято спанов / с", "type": "stat", "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0}, "datasource": {"type": "prometheus", "uid": "boohtacord_metrics"}, "targets": [{"refId": "A", "expr": "sum(rate(tempo_distributor_spans_received_total[5m]))", "instant": true}], "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}},
    {"id": 5, "title": "HTTP запросы с запуска API по маршрутам", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5}, "datasource": {"type": "prometheus", "uid": "boohtacord_metrics"}, "targets": [{"refId": "A", "expr": "sum by (http_route) (boohtacord_http_server_requests_total)", "legendFormat": "{{http_route}}"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}},
    {"id": 6, "title": "P95 задержки по маршрутам с запуска API", "type": "table", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5}, "datasource": {"type": "prometheus", "uid": "boohtacord_metrics"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, http_route) (boohtacord_http_server_duration_seconds_bucket))", "legendFormat": "{{http_route}}", "instant": true, "format": "table"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "description": "Текущая оценка по бакетам от 5 мс; при малом трафике точность ограничена."},
    {"id": 7, "title": "Самые частые маршруты с запуска API", "type": "table", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13}, "datasource": {"type": "prometheus", "uid": "boohtacord_metrics"}, "targets": [{"refId": "A", "expr": "topk(10, sum by (http_route) (boohtacord_http_server_requests_total))", "instant": true, "format": "table"}], "fieldConfig": {"defaults": {}, "overrides": []}},
    {"id": 8, "title": "Ответы по HTTP статусам с запуска API", "type": "table", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13}, "datasource": {"type": "prometheus", "uid": "boohtacord_metrics"}, "targets": [{"refId": "A", "expr": "sum by (http_response_status_code) (boohtacord_http_server_requests_total)", "instant": true, "format": "table"}], "fieldConfig": {"defaults": {}, "overrides": []}},
    {"id": 9, "title": "Активные трейсы Tempo", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 21}, "datasource": {"type": "prometheus", "uid": "boohtacord_metrics"}, "targets": [{"refId": "A", "expr": "sum(tempo_ingester_live_traces)"}], "fieldConfig": {"defaults": {}, "overrides": []}},
    {"id": 10, "title": "Память Tempo и Prometheus", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 21}, "datasource": {"type": "prometheus", "uid": "boohtacord_metrics"}, "targets": [{"refId": "A", "expr": "sum by (job) (process_resident_memory_bytes{job=~\"boohtacord-(tempo|prometheus)\"})", "legendFormat": "{{job}}"}], "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}}
  ]
}
