    {"id": 21, "title": "Очередь CPU · load / число vCPU", "type": "timeseries", "gridPos": {"x": 0, "y": 22, "w": 12, "h": 8}, "description": "100%: load равен числу vCPU. Выше 100% — очередь или ожидание I/O; это не процент занятого CPU.", "fieldConfig": {"defaults": {"unit": "percent", "noValue": "Нет данных", "decimals": 1, "min": 0, "mappings": [{"type": "special", "options": {"match": "null", "result": {"text": "Нет данных", "color": "gray"}}}]}, "overrides": []}, "datasource": {"type": "prometheus", "uid": "prometheus_main"}, "targets": [{"refId": "A", "expr": "(100 * node_load1{instance=\"176.108.242.211:9100\",job=\"BOOHTA_cloud\"} / on(instance) count by(instance) (node_cpu_seconds_total{instance=\"176.108.242.211:9100\",job=\"BOOHTA_cloud\",mode=\"idle\"})) and on(instance) (up{instance=\"176.108.242.211:9100\",job=\"BOOHTA_cloud\"} == 1)", "legendFormat": "1 мин", "instant": false, "range": true}, {"refId": "B", "expr": "(100 * node_load5{instance=\"176.108.242.211:9100\",job=\"BOOHTA_cloud\"} / on(instance) count by(instance) (node_cpu_seconds_total{instance=\"176.108.242.211:9100\",job=\"BOOHTA_cloud\",mode=\"idle\"})) and on(instance) (up{instance=\"176.108.242.211:9100\",job=\"BOOHTA_cloud\"} == 1)", "legendFormat": "5 мин", "instant": false, "range": true}, {"refId": "C", "expr": "(100 * node_load15{instance=\"176.108.242.211:9100\",job=\"BOOHTA_cloud\"} / on(instance) count by(instance) (node_cpu_seconds_total{instance=\"176.108.242.211:9100\",job=\"BOOHTA_cloud\",mode=\"idle\"})) and on(instance) (up{instance=\"176.108.242.211:9100\",job=\"BOOHTA_cloud\"} == 1)", "legendFormat": "15 мин", "instant": false, "range": true}], "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"id": 22, "title": "Swap · занято / всего", "type": "timeseries", "gridPos": {"x": 12, "y": 22, "w": 12, "h": 8}, "description": "Если всего 0 B, swap отключён. Рост занятого swap вместе с PSI памяти требует внимания.", "fieldConfig": {"defaults": {"unit": "bytes", "noValue": "Нет данных", "decimals": 1, "min": 0, "mappings": [{"type": "special", "options": {"match": "null", "result": {"text": "Нет данных", "color": "gray"}}}]}, "overrides": []}, "datasource": {"type": "prometheus", "uid": "prometheus_main"}, "targets": [{"refId": "A", "expr": "(node_memory_SwapTotal_bytes{instance=\"176.108.242.211:9100\",job=\"BOOHTA_cloud\"} - node_memory_SwapFree_bytes{instance=\"176.108.242.211:9100\",job=\"BOOHTA_cloud\"}) and on(instance) (up{instance=\"176.108.242.211:9100\",job=\"BOOHTA_cloud\"} == 1)", "legendFormat": "Занято", "instant": false, "range": true}, {"refId": "B", "expr": "(node_memory_SwapTotal_bytes{instance=\"176.108.242.211:9100\",job=\"BOOHTA_cloud\"}) and on(instance) (up{instance=\"176.108.242.211:9100\",job=\"BOOHTA_cloud\"} == 1)", "legendFormat": "Всего", "instant": false, "range": true}], "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}},
