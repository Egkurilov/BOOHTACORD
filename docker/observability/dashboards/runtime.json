    {"id": 19, "title": "CPU · занято, ожидание диска, steal", "type": "timeseries", "gridPos": {"x": 0, "y": 14, "w": 12, "h": 8}, "description": "Steal — время, отнятое гипервизором. I/O wait — ожидание диска; входит в занятость.", "fieldConfig": {"defaults": {"unit": "percent", "noValue": "Нет данных", "decimals": 1, "min": 0, "mappings": [{"type": "special", "options": {"match": "null", "result": {"text": "Нет данных", "color": "gray"}}}], "max": 100}, "overrides": []}, "datasource": {"type": "prometheus", "uid": "prometheus_main"}, "targets": [{"refId": "A", "expr": "(100 * (1 - avg by(instance) (rate(node_cpu_seconds_total{instance=\"176.108.242.211:9100\",job=\"BOOHTA_cloud\",mode=\"idle\"}[$__rate_interval])))) and on(instance) (up{instance=\"176.108.242.211:9100\",job=\"BOOHTA_cloud\"} == 1)", "legendFormat": "Занято", "instant": false, "range": true}, {"refId": "B", "expr": "(100 * avg by(instance) (rate(node_cpu_seconds_total{instance=\"176.108.242.211:9100\",job=\"BOOHTA_cloud\",mode=\"iowait\"}[$__rate_interval]))) and on(instance) (up{instance=\"176.108.242.211:9100\",job=\"BOOHTA_cloud\"} == 1)", "legendFormat": "I/O wait", "instant": false, "range": true}, {"refId": "C", "expr": "(100 * avg by(instance) (rate(node_cpu_seconds_total{instance=\"176.108.242.211:9100\",job=\"BOOHTA_cloud\",mode=\"steal\"}[$__rate_interval]))) and on(instance) (up{instance=\"176.108.242.211:9100\",job=\"BOOHTA_cloud\"} == 1)", "legendFormat": "Steal", "instant": false, "range": true}], "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}},
