    {"id": 1, "title": "Цели телеметрии доступны (из 3)", "type": "stat", "gridPos": {"x": 0, "y": 85, "w": 12, "h": 4}, "datasource": {"type": "prometheus", "uid": "boohtacord_metrics"}, "targets": [{"refId": "A", "expr": "sum(up{job=~\"boohtacord-(otel-metrics|tempo|prometheus)\"})", "instant": true}], "fieldConfig": {"defaults": {"noValue": "Нет данных", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 1}, {"color": "green", "value": 3}]}, "color": {"mode": "thresholds"}}, "overrides": []}, "description": "Коллектор метрик, Tempo и Prometheus должны давать 3 из 3.", "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none"}},
    {"id": 4, "title": "Принято спанов / с", "type": "stat", "gridPos": {"x": 12, "y": 85, "w": 12, "h": 4}, "datasource": {"type": "prometheus", "uid": "boohtacord_metrics"}, "targets": [{"refId": "A", "expr": "sum(rate(tempo_distributor_spans_received_total[5m]))", "instant": true}], "fieldConfig": {"defaults": {"unit": "ops", "noValue": "Нет данных", "color": {"mode": "fixed", "fixedColor": "blue"}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none"}},
