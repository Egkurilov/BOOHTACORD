    {"id":26,"title":"Голосовые действия","type":"table","gridPos":{"h":7,"w":12,"x":0,"y":33},"datasource":{"type":"tempo","uid":"boohtacord_tempo"},"targets":[{"refId":"A","queryType":"traceql","query":"{ span.user.id != nil && span.session.id != nil && span.user.id =~ \"${user:regex}\" && span.session.id =~ \"${session:regex}\" } && ({ name =~ \"voice[.](join|leave|reconnect)\" } || { event:name =~ \"app[.]voice[.].*\" })","limit":500,"spss":50,"tableType":"traces"}],"fieldConfig":{"defaults":{"custom":{"cellOptions":{"type":"auto"}}},"overrides":[]},"options":{"cellHeight":"sm","showHeader":true,"footer":{"show":false}},"transformations":[{"id":"organize","options":{"excludeByName":{"nested":true}}}]},
