  "panels": [
    {"id":20,"title":"Как читать трейсы","type":"text","gridPos":{"h":3,"w":24,"x":0,"y":0},"options":{"mode":"markdown","content":"**Пользователь → сессия → действие.** Выберите пользователя или нажмите на сессию. Сводка объединяет трейсы одного входа; ID спана открывает детали. Старые и фоновые данные — в диагностике внизу."}},
    {"id":21,"title":"Сессии пользователей · сводка выборки","type":"table","gridPos":{"h":6,"w":24,"x":0,"y":3},"datasource":{"type":"tempo","uid":"boohtacord_tempo"},"targets":[{"refId":"A","queryType":"traceql","query":"{ resource.service.name = \"boohtacord-api\" && span.http.route != nil && span.user.id != nil && span.session.id != nil && span.user.id =~ \"${user:regex}\" && span.session.id =~ \"${session:regex}\" && span.http.route != \"GET /api/v1/realtime\" } | select(span.user.id, span.session.id, span.http.route, span.http.response.status_code)","limit":500,"spss":50,"tableType":"spans"}],"fieldConfig":{"defaults":{"custom":{"cellOptions":{"type":"auto"}}},"overrides":[{"matcher":{"id":"byName","options":"user.id"},"properties":[{"id":"displayName","value":"Пользователь"},{"id":"custom.width","value":160}]},{"matcher":{"id":"byName","options":"session.id"},"properties":[{"id":"links","value":[{"title":"Открыть историю сессии","url":"/d/boohtacord-traces/boohtacord-7c-traces?${__url_time_range}&var-user=${__data.fields[\"user.id\"]}&var-session=${__value.raw}","targetBlank":false}]},{"id":"displayName","value":"Сессия"},{"id":"custom.width","value":160}]},{"matcher":{"id":"byName","options":"Span ID (count)"},"properties":[{"id":"unit","value":"short"},{"id":"decimals","value":0},{"id":"displayName","value":"Запросов"},{"id":"custom.width","value":80}]},{"matcher":{"id":"byName","options":"Start time (max)"},"properties":[{"id":"unit","value":"time:MM-DD HH:mm:ss"},{"id":"displayName","value":"Последний запрос"},{"id":"custom.width","value":145}]},{"matcher":{"id":"byName","options":"Duration (mean)"},"properties":[{"id":"unit","value":"ns"},{"id":"displayName","value":"Среднее"},{"id":"custom.width","value":85}]},{"matcher":{"id":"byName","options":"Duration (max)"},"properties":[{"id":"unit","value":"ns"},{"id":"displayName","value":"Максимум"},{"id":"custom.width","value":90}]}]},"options":{"cellHeight":"sm","showHeader":true,"footer":{"show":false}},"transformations":[{"id":"groupBy","options":{"fields":{"user.id":{"operation":"groupby","aggregations":[]},"session.id":{"operation":"groupby","aggregations":[]},"Span ID":{"operation":"aggregate","aggregations":["count"]},"Start time":{"operation":"aggregate","aggregations":["max"]},"Duration":{"operation":"aggregate","aggregations":["mean","max"]}}}},{"id":"sortBy","options":{"fields":{},"sort":[{"field":"Start time (max)","desc":true}]}},{"id":"organize","options":{"indexByName":{"user.id":0,"session.id":1,"Span ID (count)":2,"Start time (max)":3,"Duration (mean)":4,"Duration (max)":5}}}],"description":"Одна строка на вход пользователя. Нажмите на сессию для её истории. Числа рассчитаны по выборке до 500 трейсов и 50 запросов на трейс; это не полные счётчики трафика. WebSocket исключён из длительности API."},
    {"id":22,"title":"Действия выбранного пользователя / сессии","type":"table","gridPos":{"h":7,"w":24,"x":0,"y":9},"datasource":{"type":"tempo","uid":"boohtacord_tempo"},"targets":[{"refId":"A","queryType":"traceql","query":"{ span.user.id != nil && span.session.id != nil && span.user.id =~ \"${user:regex}\" && span.session.id =~ \"${session:regex}\" } && ({ resource.service.name =~ \"boohtacord-(web|android|ios|windows|macos)\" && name != \"api.request\" } || { resource.service.name = \"boohtacord-api\" && span.http.route != nil && span.http.request.method != \"GET\" && span.http.request.method != \"HEAD\" })","limit":500,"spss":50,"tableType":"traces"}],"fieldConfig":{"defaults":{"custom":{"cellOptions":{"type":"auto"}}},"overrides":[]},"options":{"cellHeight":"sm","showHeader":true,"footer":{"show":false}},"transformations":[{"id":"organize","options":{"excludeByName":{"nested":true}}}],"description":"Один трейс на действие; внутри доступны клиентские и серверные спаны. Связь с пользователем подтверждает API, а не присланные клиентом атрибуты."},
