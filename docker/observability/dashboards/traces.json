  "panels": [
    {"id":20,"title":"Как читать трейсы","type":"text","gridPos":{"h":3,"w":24,"x":0,"y":0},"options":{"mode":"markdown","content":"**Пользователь → сессия → действие.** Выберите пользователя или нажмите на сессию. Сводка объединяет трейсы одного входа; ID спана открывает детали. Старые и фоновые данные — в диагностике внизу.\n\nФильтр **Пользователь · имя и ID** ищется по отображаемому имени профиля BOOHTACORD. Значение фильтра — неизменный ID: совпадение имён и переименование не смешивают пользователей. Имя появляется после нового авторизованного запроса; старые трейсы остаются доступны по ID."}},
    {"id":21,"title":"Сессии пользователей · сводка выборки","type":"table","gridPos":{"h":6,"w":24,"x":0,"y":3},"datasource":{"type":"tempo","uid":"boohtacord_tempo"},"targets":[{"refId":"A","queryType":"traceql","query":"{ resource.service.name = \"boohtacord-api\" && span.http.route != nil && span.user.id != nil && span.session.id != nil && span.user.id =~ \"${user:regex}\" && span.session.id =~ \"${session:regex}\" && span.http.route != \"GET /api/v1/realtime\" } | select(span.user.name, span.user.id, span.session.id, span.http.route, span.http.response.status_code)","limit":500,"spss":50,"tableType":"spans"}],"fieldConfig":{"defaults":{"custom":{"cellOptions":{"type":"auto"}}},"overrides":[{"matcher":{"id":"byName","options":"user.id"},"properties":[{"id":"displayName","value":"Пользователь"},{"id":"custom.width","value":160}]},{"matcher":{"id":"byName","options":"session.id"},"properties":[{"id":"links","value":[{"title":"Открыть историю сессии","url":"/d/boohtacord-traces/boohtacord-7c-traces?${__url_time_range}&var-user=${__data.fields[\"user.id\"]}&var-session=${__value.raw}","targetBlank":false}]},{"id":"displayName","value":"Сессия"},{"id":"custom.width","value":160}]},{"matcher":{"id":"byName","options":"Span ID (count)"},"properties":[{"id":"unit","value":"short"},{"id":"decimals","value":0},{"id":"displayName","value":"Запросов"},{"id":"custom.width","value":80}]},{"matcher":{"id":"byName","options":"Start time (max)"},"properties":[{"id":"unit","value":"time:MM-DD HH:mm:ss"},{"id":"displayName","value":"Последний запрос"},{"id":"custom.width","value":145}]},{"matcher":{"id":"byName","options":"Duration (mean)"},"properties":[{"id":"unit","value":"ns"},{"id":"displayName","value":"Среднее"},{"id":"custom.width","value":85}]},{"matcher":{"id":"byName","options":"Duration (max)"},"properties":[{"id":"unit","value":"ns"},{"id":"displayName","value":"Максимум"},{"id":"custom.width","value":90}]},{"matcher":{"id":"byName","options":"user.name (lastNotNull)"},"properties":[{"id":"displayName","value":"Имя пользователя"}]}]},"options":{"cellHeight":"sm","showHeader":true,"footer":{"show":false}},"transformations":[{"id":"sortBy","options":{"sort":[{"field":"Start time","desc":false}]}},{"id":"groupBy","options":{"fields":{"user.id":{"operation":"groupby","aggregations":[]},"session.id":{"operation":"groupby","aggregations":[]},"Span ID":{"operation":"aggregate","aggregations":["count"]},"Start time":{"operation":"aggregate","aggregations":["max"]},"Duration":{"operation":"aggregate","aggregations":["mean","max"]},"user.name":{"operation":"aggregate","aggregations":["lastNotNull"]}}}},{"id":"sortBy","options":{"fields":{},"sort":[{"field":"Start time (max)","desc":true}]}},{"id":"organize","options":{"indexByName":{"user.id":1,"session.id":2,"Span ID (count)":3,"Start time (max)":4,"Duration (mean)":5,"Duration (max)":6,"user.name (lastNotNull)":0}}}],"description":"Одна строка на вход пользователя. Нажмите на сессию для её истории. Числа рассчитаны по выборке до 500 трейсов и 50 запросов на трейс; это не полные счётчики трафика. WebSocket исключён из длительности API."},
    {"id":33,"title":"Медиа по пользователю — последние измерения","type":"table","gridPos":{"h":9,"w":24,"x":0,"y":9},"datasource":{"type":"tempo","uid":"boohtacord_tempo"},"targets":[{"refId":"A","queryType":"traceql","query":"{ resource.service.name = \"boohtacord-api\" && name = \"media.sample\" && span.user.id != nil && span.session.id != nil && span.user.id =~ \"${user:regex}\" && span.session.id =~ \"${session:regex}\" } | select(span.user.name, span.user.id, span.session.id, span.media.platform, span.media.direction, span.media.state, span.media.rtt_ms, span.media.bitrate_kbps, span.media.encoded_fps, span.media.decoded_fps, span.media.presented_fps, span.media.packet_loss_percent, span.media.packet_loss_window_ms, span.media.target_resolution, span.media.target_fps, span.media.frame_width, span.media.frame_height, span.media.connection_quality, span.media.adaptation_reason, span.media.sample_age_ms, span.media.jitter_ms)","limit":500,"spss":1,"tableType":"spans"}],"fieldConfig":{"defaults":{"noValue":"—","custom":{"cellOptions":{"type":"auto"}}},"overrides":[{"matcher":{"id":"byName","options":"Start time (last)"},"properties":[{"id":"displayName","value":"Измерено"},{"id":"unit","value":"time:MM-DD HH:mm:ss"},{"id":"custom.width","value":145}]},{"matcher":{"id":"byName","options":"user.id"},"properties":[{"id":"displayName","value":"Пользователь"},{"id":"unit","value":"string"},{"id":"custom.width","value":150}]},{"matcher":{"id":"byName","options":"session.id"},"properties":[{"id":"displayName","value":"Сессия"},{"id":"unit","value":"string"},{"id":"custom.width","value":130},{"id":"links","value":[{"title":"Выбрать сессию","url":"/d/boohtacord-traces/boohtacord-7c-traces?${__url_time_range}&var-user=${__data.fields[\"user.id\"]}&var-session=${__value.raw}","targetBlank":false}]}]},{"matcher":{"id":"byName","options":"media.platform"},"properties":[{"id":"displayName","value":"Клиент"},{"id":"unit","value":"string"},{"id":"custom.width","value":130}]},{"matcher":{"id":"byName","options":"media.direction"},"properties":[{"id":"displayName","value":"Направление"},{"id":"unit","value":"string"},{"id":"custom.width","value":115},{"id":"mappings","value":[{"type":"value","options":{"sender":{"text":"Отправитель"},"receiver":{"text":"Зритель"},"connection":{"text":"Голос / RTT"}}}]}]},{"matcher":{"id":"byName","options":"media.state (last)"},"properties":[{"id":"displayName","value":"Состояние"},{"id":"unit","value":"string"},{"id":"custom.width","value":120}]},{"matcher":{"id":"byName","options":"media.rtt_ms (last)"},"properties":[{"id":"displayName","value":"RTT"},{"id":"unit","value":"ms"},{"id":"custom.width","value":80}]},{"matcher":{"id":"byName","options":"media.bitrate_kbps (last)"},"properties":[{"id":"displayName","value":"Битрейт"},{"id":"unit","value":"suffix:кбит/с"},{"id":"custom.width","value":100}]},{"matcher":{"id":"byName","options":"media.encoded_fps (last)"},"properties":[{"id":"displayName","value":"FPS отправки"},{"id":"unit","value":"suffix:FPS"},{"id":"custom.width","value":95}]},{"matcher":{"id":"byName","options":"media.decoded_fps (last)"},"properties":[{"id":"displayName","value":"FPS декод."},{"id":"unit","value":"suffix:FPS"},{"id":"custom.width","value":95}]},{"matcher":{"id":"byName","options":"media.presented_fps (last)"},"properties":[{"id":"displayName","value":"FPS показа"},{"id":"unit","value":"suffix:FPS"},{"id":"custom.width","value":95}]},{"matcher":{"id":"byName","options":"packet_loss_display"},"properties":[{"id":"displayName","value":"Потери ≈10 с"},{"id":"unit","value":"percent"},{"id":"custom.width","value":100},{"id":"mappings","value":[{"type":"special","options":{"match":"null+nan","result":{"text":"нет данных","color":"#808080"}}}]}]},{"matcher":{"id":"byName","options":"media.packet_loss_window_ms (last)"},"properties":[{"id":"displayName","value":"Окно потерь"},{"id":"unit","value":"ms"},{"id":"custom.width","value":100}]},{"matcher":{"id":"byName","options":"media.frame_width (last)"},"properties":[{"id":"displayName","value":"Ширина"},{"id":"unit","value":"suffix:px"},{"id":"custom.width","value":80}]},{"matcher":{"id":"byName","options":"media.frame_height (last)"},"properties":[{"id":"displayName","value":"Высота"},{"id":"unit","value":"suffix:px"},{"id":"custom.width","value":80}]},{"matcher":{"id":"byName","options":"media.target_resolution (last)"},"properties":[{"id":"displayName","value":"Цель"},{"id":"unit","value":"suffix:p"},{"id":"custom.width","value":80}]},{"matcher":{"id":"byName","options":"media.target_fps (last)"},"properties":[{"id":"displayName","value":"Цель FPS"},{"id":"unit","value":"suffix:FPS"},{"id":"custom.width","value":90}]},{"matcher":{"id":"byName","options":"media.connection_quality (last)"},"properties":[{"id":"displayName","value":"Связь"},{"id":"unit","value":"string"},{"id":"custom.width","value":100}]},{"matcher":{"id":"byName","options":"media.adaptation_reason (last)"},"properties":[{"id":"displayName","value":"Адаптация"},{"id":"unit","value":"string"},{"id":"custom.width","value":110}]},{"matcher":{"id":"byName","options":"media.sample_age_ms (last)"},"properties":[{"id":"displayName","value":"Возраст при отправке"},{"id":"unit","value":"ms"},{"id":"custom.width","value":130}]},{"matcher":{"id":"byName","options":"media.jitter_ms (last)"},"properties":[{"id":"displayName","value":"Jitter"},{"id":"unit","value":"ms"},{"id":"custom.width","value":85}]},{"matcher":{"id":"byName","options":"user.name (lastNotNull)"},"properties":[{"id":"displayName","value":"Имя пользователя"}]},{"matcher":{"id":"byName","options":"fps_target_ratio"},"properties":[{"id":"displayName","value":"FPS от цели"},{"id":"unit","value":"percentunit"},{"id":"custom.width","value":110},{"id":"custom.cellOptions","value":{"type":"color-background"}},{"id":"color","value":{"mode":"thresholds"}},{"id":"thresholds","value":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"orange","value":0.5},{"color":"green","value":0.8}]}},{"id":"mappings","value":[{"type":"special","options":{"match":"null+nan","result":{"text":"—","color":"#808080"}}}]}]}]},"options":{"cellHeight":"sm","showHeader":true,"footer":{"show":false}},"transformations":[{"id":"sortBy","options":{"sort":[{"field":"Start time","desc":false}]}},{"id":"groupBy","options":{"fields":{"user.id":{"operation":"groupby","aggregations":[]},"session.id":{"operation":"groupby","aggregations":[]},"media.platform":{"operation":"groupby","aggregations":[]},"media.direction":{"operation":"groupby","aggregations":[]},"media.state":{"operation":"aggregate","aggregations":["last"]},"media.rtt_ms":{"operation":"aggregate","aggregations":["last"]},"media.bitrate_kbps":{"operation":"aggregate","aggregations":["last"]},"media.encoded_fps":{"operation":"aggregate","aggregations":["last"]},"media.decoded_fps":{"operation":"aggregate","aggregations":["last"]},"media.presented_fps":{"operation":"aggregate","aggregations":["last"]},"media.packet_loss_percent":{"operation":"aggregate","aggregations":["last"]},"media.packet_loss_window_ms":{"operation":"aggregate","aggregations":["last"]},"media.target_resolution":{"operation":"aggregate","aggregations":["last"]},"media.target_fps":{"operation":"aggregate","aggregations":["last"]},"media.frame_width":{"operation":"aggregate","aggregations":["last"]},"media.frame_height":{"operation":"aggregate","aggregations":["last"]},"media.connection_quality":{"operation":"aggregate","aggregations":["last"]},"media.adaptation_reason":{"operation":"aggregate","aggregations":["last"]},"media.sample_age_ms":{"operation":"aggregate","aggregations":["last"]},"media.jitter_ms":{"operation":"aggregate","aggregations":["last"]},"Start time":{"operation":"aggregate","aggregations":["last"]},"user.name":{"operation":"aggregate","aggregations":["lastNotNull"]}}}},{"id":"sortBy","options":{"sort":[{"field":"Start time (last)","desc":true}]}},{"id":"calculateField","options":{"mode":"binary","binary":{"left":"media.encoded_fps (last)","operator":"/","right":"media.target_fps (last)"},"alias":"fps_target_ratio","replaceFields":false}},{"id":"calculateField","options":{"mode":"binary","binary":{"left":"media.packet_loss_percent (last)","operator":"+","right":"0"},"alias":"packet_loss_display","replaceFields":false}},{"id":"organize","options":{"indexByName":{"Start time (last)":0,"user.id":2,"media.direction":3,"media.rtt_ms (last)":4,"media.bitrate_kbps (last)":5,"media.encoded_fps (last)":6,"media.decoded_fps (last)":9,"media.packet_loss_percent (last)":10,"media.frame_width (last)":11,"media.frame_height (last)":12,"media.target_resolution (last)":13,"media.target_fps (last)":14,"media.connection_quality (last)":15,"media.platform":16,"session.id":17,"media.packet_loss_window_ms (last)":18,"media.presented_fps (last)":19,"media.adaptation_reason (last)":20,"media.state (last)":21,"media.sample_age_ms (last)":22,"media.jitter_ms (last)":23,"user.name (lastNotNull)":1,"fps_target_ratio":7,"packet_loss_display":8},"excludeByName":{"media.packet_loss_percent (last)":true}}}],"description":"Последний замер в выборке до 500 media.sample за выбранный период, по пользователю/сессии/клиенту/направлению. Смотрите время: старый замер не означает активную сессию. RTT — до SFU; sender — потеря Δlost/Δsent на старшем видеослое по RTCP, receiver — Δlost/(Δreceived+Δlost). Окно 9–12 с. Битрейт отправителя суммирует слои. Прочерк означает отсутствие данных. Цель и фактические параметры различаются. Дополнительные колонки доступны горизонтальной прокруткой. FPS от цели — диагностическое отношение фактической отправки к профилю: красный <50%, оранжевый 50–79%, зелёный ≥80%; низкое значение само по себе не доказывает неисправность (статичная сцена может не генерировать новые кадры). Отсутствие потерь — «нет данных», не 0%."},
    {"id":22,"title":"Действия выбранного пользователя / сессии","type":"table","gridPos":{"h":7,"w":24,"x":0,"y":18},"datasource":{"type":"tempo","uid":"boohtacord_tempo"},"targets":[{"refId":"A","queryType":"traceql","query":"{ span.user.id != nil && span.session.id != nil && span.user.id =~ \"${user:regex}\" && span.session.id =~ \"${session:regex}\" } && ({ resource.service.name =~ \"boohtacord-(web|android|ios|windows|macos)\" && name != \"api.request\" } || { resource.service.name = \"boohtacord-api\" && span.http.route != nil && span.http.request.method != \"GET\" && span.http.request.method != \"HEAD\" })","limit":500,"spss":50,"tableType":"traces"}],"fieldConfig":{"defaults":{"custom":{"cellOptions":{"type":"auto"}}},"overrides":[]},"options":{"cellHeight":"sm","showHeader":true,"footer":{"show":false}},"transformations":[{"id":"organize","options":{"excludeByName":{"nested":true}}}],"description":"Один трейс на действие; внутри доступны клиентские и серверные спаны. Связь с пользователем подтверждает API, а не присланные клиентом атрибуты."},
    {"id":23,"title":"Ошибки выбранной сессии","type":"table","gridPos":{"h":7,"w":12,"x":0,"y":25},"datasource":{"type":"tempo","uid":"boohtacord_tempo"},"targets":[{"refId":"A","queryType":"traceql","query":"{ span.user.id != nil && span.session.id != nil && span.user.id =~ \"${user:regex}\" && span.session.id =~ \"${session:regex}\" } && { status = error }","limit":500,"spss":50,"tableType":"traces"}],"fieldConfig":{"defaults":{"custom":{"cellOptions":{"type":"auto"}}},"overrides":[]},"options":{"cellHeight":"sm","showHeader":true,"footer":{"show":false}},"transformations":[{"id":"organize","options":{"excludeByName":{"nested":true}}}]},
    {"id":24,"title":"Медленные API-запросы (>1 с)","type":"table","gridPos":{"h":7,"w":12,"x":12,"y":25},"datasource":{"type":"tempo","uid":"boohtacord_tempo"},"targets":[{"refId":"A","queryType":"traceql","query":"{ resource.service.name = \"boohtacord-api\" && span.http.route != nil && span.user.id != nil && span.session.id != nil && span.user.id =~ \"${user:regex}\" && span.session.id =~ \"${session:regex}\" && span.http.route != \"GET /api/v1/realtime\" && duration > 1s } | select(span.user.name, span.user.id, span.session.id, span.http.route, span.http.response.status_code)","limit":500,"spss":50,"tableType":"spans"}],"fieldConfig":{"defaults":{"custom":{"cellOptions":{"type":"auto"}}},"overrides":[{"matcher":{"id":"byName","options":"user.id"},"properties":[{"id":"displayName","value":"Пользователь · ID"}]},{"matcher":{"id":"byName","options":"session.id"},"properties":[{"id":"displayName","value":"Сессия"}]},{"matcher":{"id":"byName","options":"http.route"},"properties":[{"id":"displayName","value":"Запрос"}]},{"matcher":{"id":"byName","options":"http.response.status_code"},"properties":[{"id":"displayName","value":"HTTP"}]},{"matcher":{"id":"byName","options":"spanID"},"properties":[{"id":"displayName","value":"Открыть трейс"}]},{"matcher":{"id":"byName","options":"time"},"properties":[{"id":"displayName","value":"Время"}]},{"matcher":{"id":"byName","options":"user.name"},"properties":[{"id":"displayName","value":"Имя пользователя"}]}]},"options":{"cellHeight":"sm","showHeader":true,"footer":{"show":false}},"transformations":[{"id":"organize","options":{"excludeByName":{"Trace Service":true,"Trace Name":true,"service.name":true,"Name":true},"indexByName":{"Start time":0,"user.id":2,"session.id":3,"http.route":4,"http.response.status_code":5,"Duration":6,"Span ID":7,"user.name":1}}}]},
    {"id":25,"title":"История запросов · выбранный пользователь / сессия","type":"table","gridPos":{"h":10,"w":24,"x":0,"y":32},"datasource":{"type":"tempo","uid":"boohtacord_tempo"},"targets":[{"refId":"A","queryType":"traceql","query":"{ resource.service.name = \"boohtacord-api\" && span.http.route != nil && span.user.id != nil && span.session.id != nil && span.user.id =~ \"${user:regex}\" && span.session.id =~ \"${session:regex}\" && span.http.route != \"GET /api/v1/realtime\" } | select(span.user.name, span.user.id, span.session.id, span.http.route, span.http.response.status_code)","limit":500,"spss":50,"tableType":"spans"}],"fieldConfig":{"defaults":{"custom":{"cellOptions":{"type":"auto"}}},"overrides":[{"matcher":{"id":"byName","options":"user.id"},"properties":[{"id":"displayName","value":"Пользователь · ID"}]},{"matcher":{"id":"byName","options":"session.id"},"properties":[{"id":"displayName","value":"Сессия"}]},{"matcher":{"id":"byName","options":"http.route"},"properties":[{"id":"displayName","value":"Запрос"}]},{"matcher":{"id":"byName","options":"http.response.status_code"},"properties":[{"id":"displayName","value":"HTTP"}]},{"matcher":{"id":"byName","options":"spanID"},"properties":[{"id":"displayName","value":"Открыть трейс"}]},{"matcher":{"id":"byName","options":"time"},"properties":[{"id":"displayName","value":"Время"}]},{"matcher":{"id":"byName","options":"user.name"},"properties":[{"id":"displayName","value":"Имя пользователя"}]}]},"options":{"cellHeight":"sm","showHeader":true,"footer":{"show":false}},"transformations":[{"id":"organize","options":{"excludeByName":{"Trace Service":true,"Trace Name":true,"service.name":true,"Name":true},"indexByName":{"Start time":0,"user.id":2,"session.id":3,"http.route":4,"http.response.status_code":5,"Duration":6,"Span ID":7,"user.name":1}}}],"description":"Выберите сессию в сводке или фильтрах сверху. Нажмите на ID спана, чтобы открыть полный трейс. Данные до установки корреляции доступны в диагностике ниже."},
    {"id":26,"title":"Голосовые действия","type":"table","gridPos":{"h":7,"w":12,"x":0,"y":42},"datasource":{"type":"tempo","uid":"boohtacord_tempo"},"targets":[{"refId":"A","queryType":"traceql","query":"{ span.user.id != nil && span.session.id != nil && span.user.id =~ \"${user:regex}\" && span.session.id =~ \"${session:regex}\" } && ({ name =~ \"voice[.](join|leave|reconnect)\" } || { event:name =~ \"app[.]voice[.].*\" })","limit":500,"spss":50,"tableType":"traces"}],"fieldConfig":{"defaults":{"custom":{"cellOptions":{"type":"auto"}}},"overrides":[]},"options":{"cellHeight":"sm","showHeader":true,"footer":{"show":false}},"transformations":[{"id":"organize","options":{"excludeByName":{"nested":true}}}]},
