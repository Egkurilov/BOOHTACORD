{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-platform.invalid/contracts/realtime.schema.json",
  "title": "RealtimeEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "kind", "occurred_at", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "kind": {
      "type": "string",
      "enum": ["connection.ready", "connection.resync_required", "voice.lease_revoked", "channel.updated", "presence.snapshot", "presence.changed", "message.created"]
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "enum": ["message.created"] } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["channel_id", "message_id"],
            "properties": {
              "channel_id": { "type": "string", "format": "uuid" },
              "message_id": { "type": "string", "format": "uuid" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "presence.snapshot" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["online_user_ids"],
            "properties": { "online_user_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } } }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "presence.changed" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["user_id", "presence"],
            "properties": {
              "user_id": { "type": "string", "format": "uuid" },
              "presence": { "type": "string", "enum": ["online", "offline"] }
            }
          }
        }
      }
    }
  ]
}
