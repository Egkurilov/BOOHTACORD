{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-platform.invalid/contracts/realtime.schema.json",
  "title": "RealtimeEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "kind", "occurred_at", "payload"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "kind": {
      "type": "string",
      "enum": ["connection.ready", "connection.resync_required", "voice.lease_revoked", "channel.updated", "message.created"]
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "message.created" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["channel_id", "message_id"],
            "properties": {
              "channel_id": { "type": "string", "format": "uuid" },
              "message_id": { "type": "string", "format": "uuid" }
            }
          }
        }
      }
    }
  ]
}
