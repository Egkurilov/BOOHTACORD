{
  "version": 1,
  "limits": {
    "spans": 32,
    "attributes": 32,
    "events": 8,
    "links": 8,
    "durationSeconds": 120,
    "queue": 128,
    "batch": 16,
    "exportTimeoutMs": 3000,
    "retries": 2
  },
  "operations": [
    "api.request",
    "startup",
    "session.restore",
    "auth.login",
    "message.send",
    "message.render",
    "voice.join",
    "voice.leave",
    "voice.reconnect",
    "realtime.connect",
    "realtime.reconnect",
    "realtime.process",
    "screen.share.start",
    "screen.share.stop",
    "screen.view",
    "media.sample",
    "audio.input.switch",
    "voice.audio.sample",
    "voice.volume.preference",
    "voice.disconnect",
    "telemetry.export.health"
  ],
  "fields": {
    "app.schema.version": {
      "type": "integer",
      "min": 1,
      "max": 1,
      "owner": "contract"
    },
    "session.id": {
      "type": "id",
      "owner": "server"
    },
    "app.visit.id": {
      "type": "id",
      "owner": "client"
    },
    "app.flow.id": {
      "type": "id",
      "owner": "client"
    },
    "app.media.session.id": {
      "type": "id",
      "owner": "client"
    },
    "app.flow.name": {
      "type": "enum",
      "values": [
        "startup",
        "session.restore",
        "auth.login",
        "message.send",
        "message.render",
        "voice.join",
        "voice.leave",
        "voice.reconnect",
        "realtime.connect",
        "realtime.reconnect",
        "realtime.process",
        "screen.share.start",
        "screen.share.stop",
        "screen.view",
        "telemetry.export"
      ],
      "owner": "client"
    },
    "app.flow.stage": {
      "type": "enum",
      "values": [
        "intent",
        "storage",
        "restore",
        "authenticate",
        "workspace",
        "request",
        "ack",
        "render",
        "lease",
        "credential",
        "connect",
        "microphone",
        "ready",
        "select",
        "subscribe",
        "track",
        "decoded",
        "first_frame",
        "publish",
        "stop",
        "refresh",
        "dispatch",
        "enqueue",
        "dependency",
        "commit",
        "authorize",
        "export"
      ],
      "owner": "observer"
    },
    "app.flow.record": {
      "type": "enum",
      "values": [
        "start",
        "checkpoint",
        "terminal"
      ],
      "owner": "observer"
    },
    "app.flow.outcome": {
      "type": "enum",
      "values": [
        "unknown",
        "success",
        "failed",
        "cancelled",
        "rejected",
        "timeout",
        "superseded"
      ],
      "owner": "observer"
    },
    "app.flow.reason": {
      "type": "enum",
      "values": [
        "none",
        "permission_denied",
        "network",
        "dependency",
        "invalid",
        "conflict",
        "deadline",
        "disposed",
        "generation_changed",
        "revoked",
        "unsupported",
        "export_lost"
      ],
      "owner": "observer"
    },
    "app.flow.attempt": {
      "type": "integer",
      "min": 1,
      "max": 20,
      "owner": "client"
    },
    "app.provenance": {
      "type": "enum",
      "values": [
        "client_observed",
        "server_confirmed",
        "sfu_observed"
      ],
      "owner": "server"
    },
    "app.client.version": {
      "type": "version",
      "owner": "client"
    },
    "app.sample.age_ms": {
      "type": "number",
      "min": 0,
      "max": 60000,
      "owner": "client"
    },
    "app.sample.window_ms": {
      "type": "number",
      "min": 1,
      "max": 60000,
      "owner": "client"
    },
    "app.media.capture_fps": {
      "type": "number",
      "min": 0,
      "max": 240,
      "owner": "client"
    },
    "app.media.encoded_fps": {
      "type": "number",
      "min": 0,
      "max": 240,
      "owner": "client"
    },
    "app.media.decoded_fps": {
      "type": "number",
      "min": 0,
      "max": 240,
      "owner": "client"
    },
    "app.media.presented_fps": {
      "type": "number",
      "min": 0,
      "max": 240,
      "owner": "client"
    },
    "app.media.bitrate_bps": {
      "type": "number",
      "min": 0,
      "max": 100000000,
      "owner": "client"
    },
    "app.media.rtt_ms": {
      "type": "number",
      "min": 0,
      "max": 60000,
      "owner": "client"
    },
    "app.media.jitter_ms": {
      "type": "number",
      "min": 0,
      "max": 60000,
      "owner": "client"
    },
    "app.media.loss_percent": {
      "type": "number",
      "min": 0,
      "max": 100,
      "owner": "client"
    },
    "app.media.direction": {
      "type": "enum",
      "values": [
        "sender",
        "receiver"
      ],
      "owner": "client"
    },
    "app.media.source": {
      "type": "enum",
      "values": [
        "webrtc",
        "presentation",
        "sfu"
      ],
      "owner": "server"
    },
    "app.media.target_fps": {
      "type": "number",
      "min": 1,
      "max": 240,
      "owner": "client"
    },
    "app.media.sample_state": {
      "type": "enum",
      "values": [
        "fresh",
        "stale",
        "unsupported",
        "unknown"
      ],
      "owner": "client"
    },
    "http.request.method": {
      "type": "enum",
      "values": [
        "GET",
        "HEAD",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "OPTIONS",
        "OTHER"
      ],
      "owner": "observer"
    },
    "http.response.status_code": {
      "type": "integer",
      "min": 100,
      "max": 599,
      "owner": "observer"
    },
    "app.storage.result": {
      "type": "enum",
      "values": [
        "committed",
        "replayed",
        "rejected"
      ],
      "owner": "server"
    },
    "app.media.adaptation_reason": {
      "type": "enum",
      "values": [
        "none",
        "cpu",
        "bandwidth",
        "other"
      ],
      "owner": "client"
    },
    "app.cause.truncated": {
      "type": "integer",
      "min": 0,
      "max": 1000,
      "owner": "observer"
    },
    "app.voice.mode": {
      "type": "enum",
      "values": [
        "participant",
        "listener",
        "microphone_unavailable"
      ],
      "owner": "client"
    },
    "app.export.queued": {
      "type": "integer",
      "min": 0,
      "max": 128,
      "owner": "client"
    },
    "app.export.accepted": {
      "type": "integer",
      "min": 0,
      "max": 1000000000000,
      "owner": "client"
    },
    "app.export.rejected": {
      "type": "integer",
      "min": 0,
      "max": 1000000000000,
      "owner": "client"
    },
    "app.export.dropped": {
      "type": "integer",
      "min": 0,
      "max": 1000000000000,
      "owner": "client"
    },
    "app.export.retried": {
      "type": "integer",
      "min": 0,
      "max": 1000000000000,
      "owner": "client"
    },
    "app.export.age_ms": {
      "type": "integer",
      "min": 0,
      "max": 86400000,
      "owner": "client"
    }
  }
}
