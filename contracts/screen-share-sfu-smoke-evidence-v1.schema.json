{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:boohtacord:screen-share-sfu-smoke-evidence:1",
  "title": "Screen-share SDK/SFU smoke evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceRevision", "versions", "environment", "source", "counts", "measurements", "quantiles", "results", "scenario", "limitations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceRevision": { "type": "string", "minLength": 1, "maxLength": 64 },
    "versions": {
      "type": "object", "additionalProperties": false,
      "required": ["livekitServerImage", "livekitClient", "browser"],
      "properties": {
        "livekitServerImage": { "type": "string", "minLength": 1, "maxLength": 180 },
        "livekitClient": { "type": "string", "minLength": 1, "maxLength": 32 },
        "browser": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["runnerOS", "hosted", "mode"],
      "properties": {
        "runnerOS": { "enum": ["win32", "linux", "darwin"] },
        "hosted": { "type": "boolean" },
        "mode": { "const": "headless-chromium" }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "width", "height", "requestedFps"],
      "properties": {
        "mode": { "const": "synthetic-canvas" },
        "width": { "type": ["integer", "null"], "minimum": 2 },
        "height": { "type": ["integer", "null"], "minimum": 2 },
        "requestedFps": { "type": "integer", "minimum": 1, "maximum": 60 }
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["publicationDiscovered", "framesBeforeSelection", "syntheticSourceFrames", "encoded", "decoded", "presented"],
      "properties": {
        "publicationDiscovered": { "type": "integer", "minimum": 0 },
        "framesBeforeSelection": { "type": ["integer", "null"], "minimum": 0 },
        "syntheticSourceFrames": { "type": ["integer", "null"], "minimum": 0 },
        "encoded": { "type": ["integer", "null"], "minimum": 0 },
        "decoded": { "type": ["integer", "null"], "minimum": 0 },
        "presented": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "measurements": {
      "type": "object", "additionalProperties": false,
      "required": ["firstFrameLatencyMs"],
      "properties": { "firstFrameLatencyMs": { "type": ["number", "null"], "minimum": 0 } }
    },
    "quantiles": {
      "type": "object", "additionalProperties": false,
      "required": ["firstFrameLatencyP50Ms", "firstFrameLatencyP95Ms"],
      "properties": {
        "firstFrameLatencyP50Ms": { "type": ["number", "null"], "minimum": 0 },
        "firstFrameLatencyP95Ms": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "results": {
      "type": "object", "additionalProperties": false,
      "required": ["headlessCorrectness", "hardwarePerformance", "failedAt", "failureType"],
      "properties": {
        "headlessCorrectness": { "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"] },
        "hardwarePerformance": { "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"] },
        "failedAt": { "type": ["string", "null"], "maxLength": 48 },
        "failureType": { "type": ["string", "null"], "maxLength": 64 }
      }
    },
    "scenario": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "maxLength": 64 } },
    "limitations": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "maxLength": 180 } }
  }
}
