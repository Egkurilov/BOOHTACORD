<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The complete artwork belongs on the full-bleed layer; using it as the
         safe-zone foreground scales the built-in rounded square down and
         creates a second visible frame on Pixel launchers. -->
    <background android:drawable="@drawable/ic_launcher_foreground" />
    <foreground android:drawable="@color/ic_launcher_transparent" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
